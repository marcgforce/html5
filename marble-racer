        }

        function drawTrackPiece(col, row, piece) {
            const center = getCellCenter(col, row), x = col * CELL_SIZE, y = row * CELL_SIZE, half = CELL_SIZE / 2, rWidth = ROAD_WIDTH;
            ctx.save();
            const slope = getSlopeAt(center.x, center.y);
            ctx.fillStyle = piece.type.startsWith('booster') ? '#064e3b' : '#1e293b'; 
            ctx.fillRect(x, y, CELL_SIZE, CELL_SIZE);
            
            ctx.strokeStyle = piece.type.startsWith('booster') ? '#22c55e' : `hsl(${(1 - Math.min(1, slope.slopeMag * 3500)) * 220}, 85%, 50%)`; 
            ctx.lineWidth = 3;
            ctx.strokeRect(x + 1, y + 1, CELL_SIZE - 2, CELL_SIZE - 2);
            ctx.fillStyle = piece.type.startsWith('escalator') ? '#0f4c81' : (piece.type.startsWith('booster') ? '#065f46' : '#262626');
            
            if (piece.type === 'straight_h' || piece.type === 'start_finish_h' || piece.type === 'escalator_l' || piece.type === 'escalator_r' || piece.type === 'booster_l' || piece.type === 'booster_r') {
                ctx.fillRect(x, center.y - rWidth/2, CELL_SIZE, rWidth);
                drawKerb(x, center.y - rWidth/2, CELL_SIZE, 4, true); drawKerb(x, center.y + rWidth/2 - 4, CELL_SIZE, 4, true);
                if (!piece.type.startsWith('booster')) {
                    ctx.strokeStyle = '#94a3b8'; ctx.lineWidth = 2; ctx.setLineDash([8, 6]); ctx.beginPath(); ctx.moveTo(x, center.y); ctx.lineTo(x + CELL_SIZE, center.y); ctx.stroke(); ctx.setLineDash([]);
                }
                if (piece.type === 'start_finish_h') {
                    for (let sx = 0; sx < CELL_SIZE; sx += 6) for (let sy = center.y - rWidth/2; sy < center.y + rWidth/2; sy += 6) {
                        ctx.fillStyle = ((sx / 6) + Math.floor(sy / 6)) % 2 === 0 ? '#ffffff' : '#000000'; ctx.fillRect(x + sx, sy, 6, 6);
                    }
                } else if (piece.type.startsWith('escalator')) {
                    ctx.fillStyle = '#38bdf8'; ctx.font = 'bold 14px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                    let offset = (animTime * 25) % 15;
                    if (piece.type === 'escalator_r') ctx.fillText('▶', center.x + offset - 8, center.y);
                    else ctx.fillText('◀', center.x - offset + 8, center.y);
                } else if (piece.type.startsWith('booster')) {
                    ctx.fillStyle = '#4ade80'; ctx.font = 'bold 16px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                    let offset = (animTime * 45) % 20;
                    if (piece.type === 'booster_r') ctx.fillText('»»', center.x + offset - 10, center.y);
                    else ctx.fillText('««', center.x - offset + 10, center.y);
                }
            } else if (piece.type === 'straight_v' || piece.type === 'start_finish_v' || piece.type === 'escalator_u' || piece.type === 'escalator_d' || piece.type === 'booster_u' || piece.type === 'booster_d') {
                ctx.fillRect(center.x - rWidth/2, y, rWidth, CELL_SIZE);
                drawKerb(center.x - rWidth/2, y, 4, CELL_SIZE, false); drawKerb(center.x + rWidth/2 - 4, y, 4, CELL_SIZE, false);
                if (!piece.type.startsWith('booster')) {
                    ctx.strokeStyle = '#94a3b8'; ctx.lineWidth = 2; ctx.setLineDash([8, 6]); ctx.beginPath(); ctx.moveTo(center.x, y); ctx.lineTo(center.x, y + CELL_SIZE); ctx.stroke(); ctx.setLineDash([]);
                }
                if (piece.type === 'start_finish_v') {
                    for (let sx = center.x - rWidth/2; sx < center.x + rWidth/2; sx += 6) for (let sy = 0; sy < CELL_SIZE; sy += 6) {
                        ctx.fillStyle = (Math.floor(sx / 6) + (sy / 6)) % 2 === 0 ? '#ffffff' : '#000000'; ctx.fillRect(sx, y + sy, 6, 6);
                    }
                } else if (piece.type.startsWith('escalator')) {
                    ctx.fillStyle = '#38bdf8'; ctx.font = 'bold 14px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                    let offset = (animTime * 25) % 15;
                    if (piece.type === 'escalator_u') ctx.fillText('▲', center.x, center.y - offset + 8);
                    else ctx.fillText('▼', center.x, center.y + offset - 8);
                } else if (piece.type.startsWith('booster')) {
                    ctx.fillStyle = '#4ade80'; ctx.font = 'bold 16px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                    let offset = (animTime * 45) % 20;
                    if (piece.type === 'booster_u') ctx.fillText('▲▲', center.x, center.y - offset + 10);
                    else ctx.fillText('▼▼', center.x, center.y + offset - 10);
                }
            } else if (piece.type === 'cross') {
                ctx.fillRect(x, center.y - rWidth/2, CELL_SIZE, rWidth); ctx.fillRect(center.x - rWidth/2, y, rWidth, CELL_SIZE);
                drawKerb(x, center.y - rWidth/2, CELL_SIZE, 4, true); drawKerb(x, center.y + rWidth/2 - 4, CELL_SIZE, 4, true);
                drawKerb(center.x - rWidth/2, y, 4, CELL_SIZE, false); drawKerb(center.x + rWidth/2 - 4, y, 4, CELL_SIZE, false);
                ctx.strokeStyle = '#94a3b8'; ctx.lineWidth = 2; ctx.setLineDash([6, 6]); ctx.beginPath();
                ctx.moveTo(x, center.y); ctx.lineTo(x + CELL_SIZE, center.y); ctx.moveTo(center.x, y); ctx.lineTo(center.x, y + CELL_SIZE); ctx.stroke(); ctx.setLineDash([]);
            } else if (piece.type.startsWith('turn_')) {
                let cx, cy, startAngle, endAngle;
                if (piece.type === 'turn_tl') { cx = x + CELL_SIZE; cy = y + CELL_SIZE; startAngle = Math.PI; endAngle = 1.5 * Math.PI; }
                else if (piece.type === 'turn_tr') { cx = x; cy = y + CELL_SIZE; startAngle = 1.5 * Math.PI; endAngle = 2 * Math.PI; }
                else if (piece.type === 'turn_bl') { cx = x + CELL_SIZE; cy = y; startAngle = 0.5 * Math.PI; endAngle = Math.PI; }
                else if (piece.type === 'turn_br') { cx = x; cy = y; startAngle = 0; endAngle = 0.5 * Math.PI; }
                ctx.beginPath(); ctx.arc(cx, cy, half + rWidth/2, startAngle, endAngle); ctx.arc(cx, cy, Math.max(0, half - rWidth/2), endAngle, startAngle, true); ctx.closePath(); ctx.fill();
                ctx.strokeStyle = '#94a3b8'; ctx.lineWidth = 2; ctx.setLineDash([6, 6]); ctx.beginPath(); ctx.arc(cx, cy, half, startAngle, endAngle); ctx.stroke(); ctx.setLineDash([]);
            }

            if (piece.checkpoint) {
                ctx.fillStyle = '#f59e0b';
                ctx.beginPath();
                ctx.arc(center.x, center.y, 13, 0, Math.PI * 2);
                ctx.fill();
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#000000';
                ctx.stroke();
                ctx.fillStyle = '#0f172a';
                ctx.font = 'bold 12px sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(`CP${piece.checkpoint}`, center.x, center.y);
            }

            if (piece.type.startsWith('start_finish')) {
                let maxLaps = marbles.length > 0 ? Math.max(...marbles.map(m => m.lapsCompleted)) : 0;
                ctx.fillStyle = 'rgba(15, 23, 42, 0.9)';
                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.roundRect(center.x - 38, y - 24, 76, 20, 4);
                ctx.fill();
                ctx.stroke();
                ctx.fillStyle = '#38bdf8';
                ctx.font = 'bold 11px sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(`Tours : ${maxLaps}/${totalLaps}`, center.x, y - 14);
            }

            if (isEditMode) { 
                ctx.fillStyle = '#f8fafc'; 
                ctx.font = 'bold 10px monospace'; 
                ctx.textAlign = 'right'; 
                ctx.textBaseline = 'alphabetic'; 
                ctx.fillText(`${Math.round(piece.elevation)}m`, x + CELL_SIZE - 4, y + 12); 
            }
            ctx.restore();
        }

        function drawKerb(x, y, w, h, isHorizontal) { ctx.fillStyle = '#ef4444'; ctx.fillRect(x, y, w, h); ctx.fillStyle = '#ffffff'; const step = 8; if (isHorizontal) { for (let i = 0; i < w; i += step * 2) ctx.fillRect(x + i, y, step, h); } else { for (let i = 0; i < h; i += step * 2) ctx.fillRect(x, y + i, w, step); } }
        
