        function formatRaceTime(ms) {
            if (!Number.isFinite(ms)) return '--:--.---';
            return `${String(Math.floor(ms / 60000)).padStart(2,'0')}:` +
                   `${String(Math.floor((ms % 60000) / 1000)).padStart(2,'0')}.` +
