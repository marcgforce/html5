        }

        function buildMarbleDetails(m) {
            const h = m.history || { checkpointLog: [] };
            const log = h.checkpointLog || [];

            let html = `<div class="detail-title">📋 Journal de ${m.name}</div>`;

            if (!log.length) {
                html += `<div class="detail-line" style="color:#94a3b8;">Aucun checkpoint rencontré.</div>`;
                return html;
            }

            // Affichage séparé par tour : on montre exactement ce que la bille
            // a rencontré, dans l'ordre, sans parler d'anomalie ou de mauvaise direction.
            const byLap = new Map();
            log.forEach(item => {
                if (!byLap.has(item.lap)) byLap.set(item.lap, []);
                byLap.get(item.lap).push(item);
            });

            byLap.forEach((items, lap) => {
                const sequence = items.map(item => `CP${item.cp}`).join(' → ');
                html += `<div class="detail-line" style="margin-top:6px;"><b>Tour ${lap}</b></div>`;
                html += `<div class="detail-line" style="color:#cbd5e1; line-height:1.7;">${sequence}</div>`;
            });

            return html;
        }

        function isValidFinisherForPodium(m) {
            if (!m.finished || m.lapsCompleted < totalLaps) return false;
            const max = getMaxCheckpoint();
            if (max === 0) return true;
            const lastLap = (m.history?.checkpoints || []).filter(x => x.lap === totalLaps).map(x => x.cp);
            return lastLap.length === max && lastLap.every((cp, i) => cp === i + 1);
        }

        function updateLeaderboardUI() {
            const list = document.getElementById('rankList');

            // Si un journal est ouvert, on mémorise la bille concernée.
            // Le classement peut changer après un CP, donc l'index n'est pas fiable.
            const openDetails = list.querySelector('.rank-details.open');
            const openMarbleId = openDetails
                ? openDetails.parentElement?.dataset.marbleId
                : null;

            list.innerHTML = '';

            const maxCp = getMaxCheckpoint();

            const getPassedCheckpoints = (m) => {
                if (maxCp === 0) return 0;
                return Math.min(
                    Math.max((m.nextCheckpoint || 1) - 1, 0),
                    maxCp
                );
            };

            let sorted = [...marbles].sort((a, b) => {
                const aFinished = isValidFinisherForPodium(a);
                const bFinished = isValidFinisherForPodium(b);
                if (aFinished !== bFinished) return aFinished ? -1 : 1;
                if (aFinished && bFinished) {
                    return (a.finishTime ?? Infinity) - (b.finishTime ?? Infinity);
                }
                if (a.lapsCompleted !== b.lapsCompleted) {
                    return b.lapsCompleted - a.lapsCompleted;
                }
                const cpA = getPassedCheckpoints(a);
                const cpB = getPassedCheckpoints(b);
                if (cpA !== cpB) return cpB - cpA;
                return (a.lastCheckpointTime || Infinity) -
                       (b.lastCheckpointTime || Infinity);
            });

            sorted.forEach((m, index) => {
                const li = document.createElement('li');
                li.className = 'rank-item-wrap';
                li.dataset.marbleId = String(m.id);

                const passedCp = getPassedCheckpoints(m);
                const cpStatus = maxCp > 0 ? ` | CP: ${passedCp}/${maxCp}` : '';

                let statsHtml =
                    `<div class="rank-stats">` +
                    `<span style="color:#38bdf8;font-weight:bold;">` +
                    `Tours : ${m.lapsCompleted} / ${totalLaps}${cpStatus}` +
                    `</span>`;

                if (m.bestLapTime) {
                    statsHtml += `<span>Best: ${(m.bestLapTime / 1000).toFixed(3)}s</span>`;
                }
                statsHtml += `</div>`;

                li.innerHTML = `
                    <div class="rank-item">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <div class="rank-badge" style="background:${m.color};">${m.id}</div>
                            <b>P${index + 1}</b> (${m.name})
                        </div>
                        ${statsHtml}
                        <button id="marble-more-${index}" class="rank-more-btn"
                                title="Afficher les détails"
                                onclick="toggleMarbleDetails(${index})">+</button>
                    </div>
                    <div id="marble-details-${index}" data-marble-id="${m.id}" class="rank-details">
                        ${buildMarbleDetails(m)}
                    </div>`;

                list.appendChild(li);

                // Si ce journal était ouvert avant le rafraîchissement,
                // on le rouvre automatiquement sur la même bille.
                if (openMarbleId === String(m.id)) {
                    const details = li.querySelector('.rank-details');
                    const btn = li.querySelector('.rank-more-btn');
                    if (details && btn) {
                        details.classList.add('open');
                        btn.textContent = '−';
                        btn.title = 'Masquer les détails';
                    }
                }
            });
        }

        function triggerPodiumAnimation() {
            podiumOverlay.style.display = 'flex';
            // Le podium est basé exclusivement sur les concurrents
            // qui ont réellement franchi la ligne d'arrivée. Dès que 3 billes
            // sont arrivées, ces trois places sont définitives.
            let sorted = [...marbles]
                .filter(m => isValidFinisherForPodium(m) && Number.isFinite(m.finishTime))
                .sort((a, b) => a.finishTime - b.finishTime);
            let container = document.getElementById('podiumStepsContainer');
            container.innerHTML = '';
            
            const createStep = (marble, pos, heightClass) => {
                if (!marble) return '';
                return `<div class="podium-col ${heightClass}">
                            <div class="podium-ball-avatar" style="background:${marble.color};">${marble.id}</div>
                            <div style="font-size:1.5rem; margin-bottom:4px;">${pos === 1 ? '🥇' : pos === 2 ? '🥈' : '🥉'}</div>
                            <div>P${pos}</div>
                            <div class="podium-name">${marble.name}</div>
                        </div>`;
            };

            container.innerHTML = createStep(sorted[1], 2, 'podium-2') + createStep(sorted[0], 1, 'podium-1') + createStep(sorted[2], 3, 'podium-3');
            
            let remList = document.getElementById('podiumRemainingList');
            remList.innerHTML = '';

            // Si plusieurs billes ont franchi la ligne dans la même frame,
            // afficher aussi les éventuels P4, P5, etc. déjà arrivés.
            for (let i = 3; i < sorted.length; i++) {
                remList.innerHTML += `<div style="display:flex; justify-content:space-between; margin-bottom:4px; padding-bottom:4px; border-bottom:1px solid #334155;">
                    <span style="color:${sorted[i].color}; font-weight:bold;">${sorted[i].name}</span>
                    <span>P${i + 1} - ${(sorted[i].finishTime / 1000).toFixed(3)}s</span>
                </div>`;
            }

            // Les autres concurrents n'ont pas encore terminé : ils ne peuvent
            // plus modifier le podium et la course est donc arrêtée.
            const stillRacing = marbles.filter(m => !m.finished);
            if (stillRacing.length > 0) {
                remList.innerHTML += `<div style="margin-top:6px; padding-top:6px; color:#64748b; border-top:1px solid #334155;">
                    ${stillRacing.length} bille${stillRacing.length > 1 ? 's' : ''} encore en course
                </div>`;
            }
        }
        
        function closePodiumAndReset() { podiumOverlay.style.display = 'none'; resetRace(); }
        
        function exportTrack() { 
            const blob = new Blob([JSON.stringify(Array.from(grid.entries()), null, 2)], { type: 'application/json' }); 
            const url = URL.createObjectURL(blob); 
            const a = document.createElement('a'); 
            a.href = url; 
            a.download = 'circuit.json'; 
            a.click(); 
            URL.revokeObjectURL(url); 
        }

        function triggerImport() { document.getElementById('importInput').click(); }

        function importTrackFile(event) { 
            const file = event.target.files[0]; 
            if (!file) return; 
            const reader = new FileReader(); 
            reader.onload = function(e) { 
                try { 
                    const data = JSON.parse(e.target.result); 
                    grid.clear(); 
                    data.forEach(([k, v]) => grid.set(k, v)); 
                    buildPhysicsWalls(); 
                    createMarbles(); 
                    centerCameraOnTrack();
                } catch (err) { 
                    alert('Erreur import'); 
                } 
            }; 
            reader.readAsText(file); 
            event.target.value = ''; 
        }
        
        function startQualifying() {
            stopRace();
            isQualifying = true; qualifMarbleIndex = 0; qualifTimesMap = {}; raceFinished = false; podiumOverlay.style.display = 'none';
            document.getElementById('leaderboardTitle').textContent = "Qualifications en cours...";
            document.getElementById('timer').textContent = "00:00.000";
            buildPhysicsWalls(); spawnNextQualifMarble();
        }

        function spawnNextQualifMarble() {
            if (qualifMarbleIndex >= numMarbles) {
                isQualifying = false;
                marbles.sort((a, b) => (qualifTimesMap[a.id] || Infinity) - (qualifTimesMap[b.id] || Infinity));
                document.getElementById('leaderboardTitle').textContent = "Grille de Départ Prête";
                createMarbles(true); draw(); return;
            }
            
            marbles.forEach(m => World.remove(engine.world, m.body)); marbles = [];
            let startPos = null; grid.forEach((val, key) => { if (val.type.startsWith('start_finish')) { const [col, row] = key.split(',').map(Number); startPos = getCellCenter(col, row); } });
            if (!startPos) startPos = { x: 200, y: 200 };
            
            const idx = qualifMarbleIndex;
            const body = Bodies.circle(startPos.x, startPos.y, 8, { restitution: 0.5, friction: 0.0001, frictionAir: 0.0006, density: 0.008 });
            World.add(engine.world, body);
            
            currentQualifMarble = { 
                id: idx + 1, 
                name: MARBLE_NAMES[idx % MARBLE_NAMES.length], // Assignation du nom en qualification
                color: MARBLE_COLORS[idx % MARBLE_COLORS.length], 
                body, 
                lapsCompleted: 0, 
                bestLapTime: null, 
                lapStartTime: performance.now(), 
                lastLapTime: 0, 
                finished: false, 
                nextCheckpoint: 1,
                lapValidatedCheckpoints: [],
                lastCheckpointTime: 0,
                history: {
                    checkpoints: [],
                    cells: [],
                    events: [],
                    lastTileKey: null,
                    lastTileTime: 0,
                    offTrackSince: null
                }
            };
            marbles.push(currentQualifMarble);
            
            raceRunning = true; raceStartTime = performance.now(); currentQualifMarble.lapStartTime = raceStartTime;
            if (!animFrameId) runEngine();
        }

        function loadDemoTrack() {
            grid.clear();
            const demo = [
                { col: 3, row: 2, type: 'turn_tl', elevation: 100, checkpoint: null }, { col: 4, row: 2, type: 'start_finish_h', elevation: 90, checkpoint: null },
                { col: 5, row: 2, type: 'turn_tr', elevation: 80, checkpoint: 1 }, { col: 5, row: 3, type: 'straight_v', elevation: 70, checkpoint: null },
                { col: 5, row: 4, type: 'turn_br', elevation: 60, checkpoint: 2 }, { col: 4, row: 4, type: 'straight_h', elevation: 50, checkpoint: null },
                { col: 3, row: 4, type: 'turn_bl', elevation: 40, checkpoint: 3 }, { col: 3, row: 3, type: 'escalator_u', elevation: 10, checkpoint: null }
            ];
            demo.forEach(d => grid.set(`${d.col},${d.row}`, { type: d.type, elevation: d.elevation, checkpoint: d.checkpoint }));
            applyAutoSlope();
            centerCameraOnTrack();
        }

        resize();
        loadDemoTrack();
    </script>
</body>
</html>
